[Unit]
Description=Cloudflare Argo Tunnel
After=network.target sb.service
Wants=network-online.target
Requires=sb.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/cloudflared-argo-start.sh
# 重启策略
Restart=always
RestartSec=10
# 安全加固
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/etc/s-box /var/lock /tmp
# 资源限制
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
